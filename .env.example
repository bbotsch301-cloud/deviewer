# Optional: secret used to verify GitHub webhook signatures (X-Hub-Signature-256).
# Set the same value in your GitHub webhook configuration.
# If empty, the webhook accepts unsigned requests (useful for local testing).
GITHUB_WEBHOOK_SECRET=

# Required for the "Ask Claude to explain this" feature.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# When set to "true", the test runner uses the staged setTimeout simulation
# instead of executing real shell commands. Useful for demos without a real
# repo. When unset/false, the runner spawns the commands configured per repo
# (and falls back to simulation only if no commands are configured).
USE_SIMULATION=
