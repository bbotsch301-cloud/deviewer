{
  "manifest_version": 3,
  "name": "deviewer — live console",
  "version": "0.2.0",
  "description": "Watch your deviewer pipeline runs stream live in a Chrome side panel.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Open deviewer side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
